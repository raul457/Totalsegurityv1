# Copie este arquivo para .env e preencha os valores
# No Vercel: adicione estas variáveis em Settings > Environment Variables

# ── WhatsApp Cloud API (Meta for Developers) ─────────────────────────────────
# https://developers.facebook.com/apps/ → seu app → WhatsApp → API Setup
WHATSAPP_TOKEN=seu_token_aqui
WHATSAPP_PHONE_ID=seu_phone_number_id_aqui

# Número que vai receber os orçamentos (formato internacional sem +)
RECIPIENT_PHONE=5544991561510

# Versão da API do WhatsApp (deixe como está)
WHATSAPP_API_VERSION=v17.0

# ── Banco de Dados PostgreSQL ─────────────────────────────────────────────────
# Supabase:  Settings > Database > Connection String (URI mode)
# Neon:      Dashboard > Connection Details > Connection string
# Vercel:    Storage > Postgres > .env.local tab
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
